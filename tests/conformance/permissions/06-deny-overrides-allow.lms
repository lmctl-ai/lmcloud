# Requires: permissions
# Scenario 06: Deny precedence — Allow + Deny on the same action/resource evaluates to denied; a narrower
# deny prefix only blocks its own sub-path.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
bucket = "lmcloud-p06-" + run_id + "-x";
pr = "arn:aws:iam::000000000000:role/reader-" + run_id;

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("permissions", ep);
    cloud.set_endpoint("storage", ep);
  }
  let b = ${bucket};
  cloud.bucket_create(b);

  # exact-overlap deny beats allow
  cloud.policy_attach("storage:bucket:" + b, ${pr},
    cloud.policy_new().statement("Allow", str_list().add("storage.object.delete"), str_list().add("storage:object:" + b + "/tmp/*")));
  cloud.policy_attach("storage:bucket:" + b, ${pr},
    cloud.policy_new().statement("Deny", str_list().add("storage.object.delete"), str_list().add("storage:object:" + b + "/tmp/*")));
  let denied = cloud.policy_check(${pr}, "storage.object.delete", "storage:object:" + b + "/tmp/1");

  # narrow deny: allow all objects, deny only secret/*
  cloud.policy_attach("storage:bucket:" + b, ${pr},
    cloud.policy_new().statement("Allow", str_list().add("storage.object.read"), str_list().add("storage:object:" + b + "/*")));
  cloud.policy_attach("storage:bucket:" + b, ${pr},
    cloud.policy_new().statement("Deny", str_list().add("storage.object.read"), str_list().add("storage:object:" + b + "/secret/*")));
  let secret = cloud.policy_check(${pr}, "storage.object.read", "storage:object:" + b + "/secret/k");
  let publick = cloud.policy_check(${pr}, "storage.object.read", "storage:object:" + b + "/public/k");

  cloud.policy_detach("storage:bucket:" + b, ${pr});
  cloud.bucket_delete(b);

  lmcode_return_put("denied", denied);
  lmcode_return_put("secret_denied", !secret);
  lmcode_return_put("public_allowed", publick);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "06-deny-overrides-allow host execution failed");
assert(!r.result.denied, "explicit Deny must override Allow on the same action/resource");
assert(r.result.secret_denied, "narrower deny must block its sub-path");
assert(r.result.public_allowed, "keys outside the deny prefix must stay allowed");
