# Requires: permissions
# Scenario 02: policy_lint accepts a least-privilege policy (exact actions, exact resources): ok()==true,
# zero findings; lint is offline (no provider call).
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
bucket = "lmcloud-p02-" + run_id + "-x";
queue = "lmcloud-p02-" + run_id + "-q";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("permissions", ep);
  }
  let p = cloud.policy_new()
    .statement("Allow", str_list().add("storage.object.read"), str_list().add("storage:object:" + ${bucket} + "/public/*"))
    .statement("Allow", str_list().add("queue.queue.receive").add("queue.queue.ack"), str_list().add("queue:queue:" + ${queue}));

  let rep = cloud.policy_lint(p);
  lmcode_return_put("lint_ok", rep.ok());
  lmcode_return_put("findings", rep.len());
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "02-policy-lint-clean-pass host execution failed");
assert(r.result.lint_ok, "least-privilege policy must lint ok");
assert(r.result.findings == 0, "least-privilege policy must produce zero findings");
