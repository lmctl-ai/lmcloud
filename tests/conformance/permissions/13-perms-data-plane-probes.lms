# Requires: permissions
# Scenario 13: Real data-plane enforcement probes (design 15 §3.4) — attachments must be visible to the
# simulator's real authorization engine, not only to the reference evaluator.
#
# Fixture requirements (16 §1): AWS leg only; other providers are gated upfront (epics A-P2/A-P3/A-P4 —
# unsupported legs are gated, never probed).
#   - LMCLOUD_ENFORCE_GRANTED_AWS_ACCESS_KEY_ID / _SECRET_ACCESS_KEY: a valid sim identity the auth
#     fixture denies by default.
#   - LMCLOUD_ENFORCE_GRANTED_PRINCIPAL: the principal string the sim auth layer maps those credentials
#     to (the portable grant target — never an invented ARN).
#   - LMCLOUD_ENFORCE_DENIED_AWS_*: a valid but unrelated/ungranted identity.
# SKIP policy: exactly two reasons — open auth mode, or an attach failing with the documented
# UNSUPPORTED_MAPPING classification (design 15 §5.2). Every other failure FAILS this scenario.
# The seed identity is restored before every later block and used for cleanup (success or failure).
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
host = ARGV[0];
probe_bucket = "lmcloud-p13-" + run_id + "-probe";
target = "lmcloud-p13-" + run_id + "-t";

if (!contains(host, "lmaws")) {
  println("SKIP: scenario 13 data-plane fixtures/attach routes are configured for awssim only (azure A-P2, gcp A-P3, oci A-P4) — unsupported legs are gated, never probed");
  exit(0);
}

seed_key = env("LMAWS_SIM_ACCESS_KEY_ID", "");
seed_secret = env("LMAWS_SIM_SECRET_ACCESS_KEY", "");
granted_key = env("LMCLOUD_ENFORCE_GRANTED_AWS_ACCESS_KEY_ID", "");
granted_secret = env("LMCLOUD_ENFORCE_GRANTED_AWS_SECRET_ACCESS_KEY", "");
granted_principal = env("LMCLOUD_ENFORCE_GRANTED_PRINCIPAL", "");
denied_key = env("LMCLOUD_ENFORCE_DENIED_AWS_ACCESS_KEY_ID", "");
denied_secret = env("LMCLOUD_ENFORCE_DENIED_AWS_SECRET_ACCESS_KEY", "");

# ---- Mode probe: bogus credentials -> UNAUTHENTICATED iff --auth enforce ----
set_env("LMAWS_SIM_ACCESS_KEY_ID", "AKIAUNAUTH0000000000");
set_env("LMAWS_SIM_SECRET_ACCESS_KEY", "wrong-secret-key-for-unauthenticated-pass");
probe_prog = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("permissions", ep);
    cloud.set_endpoint("storage", ep);
  }
  cloud.set_abort_on_error(false);
  let created = cloud.bucket_create(${probe_bucket});
  let open_mode = cloud.last_error().code() == ErrorCode.OK;
  if (open_mode) {
    if (created || cloud.bucket_exists(${probe_bucket})) { cloud.bucket_delete(${probe_bucket}); }
  }
  lmcode_return_put("open_mode", open_mode);
end _lmcode_
rp = run_lmcode(probe_prog, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(rp.ok, "13 probe host execution failed");

# shared cleanup program (top level so `end _lmcode_` starts at column 1)
cleanup_prog = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("permissions", ep);
    cloud.set_endpoint("storage", ep);
  }
  let gpr = ${granted_principal};
  cloud.set_abort_on_error(false);
  cloud.policy_detach("storage:bucket:" + ${target}, gpr);
  cloud.object_delete(${target}, "readable.txt");
  cloud.bucket_delete(${target});
end _lmcode_

# Restore the privileged (seed) identity IMMEDIATELY, on every later path
set_env("LMAWS_SIM_ACCESS_KEY_ID", seed_key);
set_env("LMAWS_SIM_SECRET_ACCESS_KEY", seed_secret);

if (rp.result.open_mode) {
  println("SKIP: simulator is in --auth open mode; scenario 13 requires --auth enforce");
  exit(0);
}

# ---- Fixture gate: granted/denied identities + mapped grantee principal must be configured ----
if (len(granted_key) == 0 || len(granted_secret) == 0 || len(granted_principal) == 0 || len(denied_key) == 0 || len(denied_secret) == 0) {
  println("SKIP: fixture env unset (need LMCLOUD_ENFORCE_GRANTED_AWS_* + LMCLOUD_ENFORCE_GRANTED_PRINCIPAL + LMCLOUD_ENFORCE_DENIED_AWS_*) — no data-plane proof without real configured identities");
  exit(0);
}

# ---- Seed + attach with the restored privileged identity ----
attach_prog = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("permissions", ep);
    cloud.set_endpoint("storage", ep);
  }
  let t = ${target};
  let gpr = ${granted_principal};
  cloud.bucket_create(t);
  let mk = cloud.last_error();
  cloud.object_put(t, "readable.txt", "hello");
  let put_err = cloud.last_error();

  cloud.set_abort_on_error(false);
  cloud.policy_attach("storage:bucket:" + t, gpr,
    cloud.policy_new().statement("Allow", str_list().add("storage.object.read"), str_list().add("storage:object:" + t + "/*")));
  let e = cloud.last_error();
  # The ONLY sanctioned skip classification: explicit unsupported native/sim route (design 15 §5.2)
  let unmapped = e.code() == ErrorCode.INVALID_ARGUMENT && e.provider_code() == "UNSUPPORTED_MAPPING";

  lmcode_return_put("seed_ok", mk.ok() && put_err.ok());
  lmcode_return_put("attach_ok", e.ok());
  lmcode_return_put("unmapped", unmapped);
  lmcode_return_put("err_msg", e.message());
end _lmcode_
ra = run_lmcode(attach_prog, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(ra.ok, "13 attach host execution failed");
assert(ra.result.seed_ok, "seed identity must create the bucket/object (mode fixture sanity)");
if (ra.result.unmapped) {
  println("SKIP: storage bucket-policy attach route UNSUPPORTED_MAPPING on this sim (epic A-P1)");
  rc0 = run_lmcode(cleanup_prog, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
  exit(0);
}
if (!ra.result.attach_ok) {
  println("FAIL: policy_attach failed with a non-classified error (not UNSUPPORTED_MAPPING): " + ra.result.err_msg);
  rc0 = run_lmcode(cleanup_prog, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
  exit(1);
}

# ---- Leg B: granted identity performs the REAL data-plane read (must succeed) ----
set_env("LMAWS_SIM_ACCESS_KEY_ID", granted_key);
set_env("LMAWS_SIM_SECRET_ACCESS_KEY", granted_secret);
read_prog = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) { cloud.set_endpoint("storage", ep); }
  cloud.set_abort_on_error(false);
  let body = cloud.object_get(${target}, "readable.txt");
  let e = cloud.last_error();
  lmcode_return_put("read_ok", e.ok() && body == "hello");
  lmcode_return_put("msg", e.message());
end _lmcode_
rb = run_lmcode(read_prog, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});

# ---- Leg C: valid but UNGRANTED identity is denied at the data plane (PERMISSION_DENIED exact) ----
set_env("LMAWS_SIM_ACCESS_KEY_ID", denied_key);
set_env("LMAWS_SIM_SECRET_ACCESS_KEY", denied_secret);
deny_prog = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) { cloud.set_endpoint("storage", ep); }
  cloud.set_abort_on_error(false);
  cloud.object_get(${target}, "readable.txt");
  let e = cloud.last_error();
  lmcode_return_put("denied_code_ok", e.code() == ErrorCode.PERMISSION_DENIED);
  lmcode_return_put("msg", e.message());
end _lmcode_
rc = run_lmcode(deny_prog, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});

# ---- Cleanup with the restored seed identity — runs regardless of leg outcomes ----
set_env("LMAWS_SIM_ACCESS_KEY_ID", seed_key);
set_env("LMAWS_SIM_SECRET_ACCESS_KEY", seed_secret);
rcl = run_lmcode(cleanup_prog, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});

assert(rb.ok, "13 granted-read host execution failed");
assert(rb.result.read_ok, "granted identity must READ the object via the real sim auth engine (data-plane proof)");
assert(rc.ok, "13 denied-read host execution failed");
assert(rc.result.denied_code_ok, "valid unrelated identity must be PERMISSION_DENIED at the data plane (never UNAUTHENTICATED)");
