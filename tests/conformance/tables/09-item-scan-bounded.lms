# Requires: tables
# Scenario 09: Bounded unordered scan with pagination — collect the exact inserted item set
# (order NOT assumed), across partitions; max_items out-of-range pre-flight guards.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
t1 = "lmt09" + run_id + "a";   # sorted

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("tables", ep);
  }
  let t = ${t1};
  cloud.table_create(t, true);

  # 6 items across 2 partitions
  let keys = str_list()
    .add("A:01").add("A:02").add("A:03")
    .add("B:01").add("B:02").add("B:03");
  let i = 0;
  while (i < keys.len()) {
    let kv = keys.at(i);
    let pk = str_substr(kv, 0, 1);
    let sk = str_substr(kv, 2, 2);
    cloud.item_put(t, cloud.item_new(pk, sk).set_string("c", kv));
    i = i + 1;
  }

  # token-walked scan with max=2 (bounded poll until total seen)
  let seen = str_list();
  let tok = "";
  let guard = 0;
  let page = cloud.item_scan(t, 2, "");
  guard = guard + 1;
  let j = 0;
  while (j < page.len()) {
    seen = seen.add(page.at(j).pk() + ":" + page.at(j).sk());
    j = j + 1;
  }
  let polls = 0;
  while (seen.len() < 6 && polls < 10 && !page.has_more()) {
    polls = polls + 1;
    page = cloud.item_scan(t, 2, tok);
    j = 0;
    while (j < page.len()) {
      seen = seen.add(page.at(j).pk() + ":" + page.at(j).sk());
      j = j + 1;
    }
  }
  while (page.has_more() && guard < 12) {
    guard = guard + 1;
    tok = page.next_token();
    page = cloud.item_scan(t, 2, tok);
    j = 0;
    while (j < page.len()) {
      seen = seen.add(page.at(j).pk() + ":" + page.at(j).sk());
      j = j + 1;
    }
  }

  let all_found = keys.len() == seen.len();
  let k = 0;
  while (k < keys.len()) {
    if (seen.index_of(keys.at(k)) < 0) { all_found = false; }
    k = k + 1;
  }

  cloud.set_abort_on_error(false);
  cloud.item_scan(t, 501, "");          # out of range
  let hi_err = cloud.last_error();
  cloud.item_scan(t, -1, "");           # out of range
  let lo_err = cloud.last_error();
  let bounds_ok = hi_err.code() == ErrorCode.INVALID_ARGUMENT && hi_err.http_status() == 0
    && lo_err.code() == ErrorCode.INVALID_ARGUMENT && lo_err.http_status() == 0;
  cloud.set_abort_on_error(true);

  cloud.table_delete(t);

  lmcode_return_put("seen_n", seen.len());
  lmcode_return_put("all_found", all_found);
  lmcode_return_put("bounds_ok", bounds_ok);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "09 host execution failed");
assert(r.result.seen_n == 6 && r.result.all_found, "scan must collect the exact 6-item inserted set across partitions");
assert(r.result.bounds_ok, "scan max_items outside 0..500 must fail pre-flight INVALID_ARGUMENT (http_status 0)");
