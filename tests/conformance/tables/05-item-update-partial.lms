# Requires: tables
# Scenario 05: item_update partial merge (only stated attributes change; others preserved),
# version rotation on update, and NOT_FOUND for updating a missing item.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
t1 = "lmt05" + run_id + "a";   # key-only
t2 = "lmt05" + run_id + "b";   # sorted

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("tables", ep);
  }
  let ta = ${t1};
  let tb = ${t2};
  cloud.table_create(ta);
  cloud.table_create(tb, true);

  let base = cloud.item_new("cfg").set_string("tier", "free").set_int("quota", 1000).set_bool("on", false);
  let stored = cloud.item_put(ta, base);
  let v_before = stored.version();

  # merge: only "quota" stated -> "tier" and "on" must be preserved
  let chg = cloud.item_new("cfg").set_int("quota", 2500);
  let merged = cloud.item_update(ta, "cfg", chg);
  let kept_ok = merged.get_string("tier") == "free" && merged.get_bool("on") == false && merged.get_int("quota") == 2500;
  let v_after = merged.version();
  let ver_rotated = str_len(v_after) > 0 && v_after != v_before;

  # sorted variant
  cloud.item_put(tb, cloud.item_new("s1", "k1").set_string("a", "1").set_string("b", "2"));
  let m2 = cloud.item_update(tb, "s1", "k1", cloud.item_new("s1", "k1").set_string("b", "B"));
  let sorted_ok = m2.get_string("a") == "1" && m2.get_string("b") == "B";

  # update of a missing item -> NOT_FOUND
  cloud.set_abort_on_error(false);
  cloud.item_update(ta, "ghost", cloud.item_new("ghost").set_string("x", "y"));
  let miss_err = cloud.last_error();
  let miss_nf = miss_err.code() == ErrorCode.NOT_FOUND;
  cloud.item_update(tb, "no", "ne", cloud.item_new("no", "ne").set_string("x", "y"));
  let miss2_err = cloud.last_error();
  let miss2_nf = miss2_err.code() == ErrorCode.NOT_FOUND;
  cloud.set_abort_on_error(true);

  cloud.table_delete(ta);
  cloud.table_delete(tb);

  lmcode_return_put("kept_ok", kept_ok);
  lmcode_return_put("ver_rotated", ver_rotated);
  lmcode_return_put("sorted_ok", sorted_ok);
  lmcode_return_put("miss_nf", miss_nf);
  lmcode_return_put("miss2_nf", miss2_nf);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "05 host execution failed");
assert(r.result.kept_ok, "item_update must merge (preserve unstated attributes)");
assert(r.result.ver_rotated, "item_update must rotate version()");
assert(r.result.sorted_ok, "item_update works on sorted tables");
assert(r.result.miss_nf && r.result.miss2_nf, "item_update on missing item must be NOT_FOUND");
