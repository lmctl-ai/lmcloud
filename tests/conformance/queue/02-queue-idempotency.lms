# Scenario 02: Idempotent queue_create (returns false when already exists) and queue_delete (returns false when already absent).
# Uses distinct queue names, never recreates a deleted queue (SQS 60s QueueDeletedRecently safe),
# and polls for post-delete disappearance before testing second delete (M3).
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
q_active = "lmcloud-q02-" + run_id + "-active";
q_never = "lmcloud-q02-" + run_id + "-never";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("queue", ep);
  }
  let q = ${q_active};
  let never_q = ${q_never};

  let delete_never = cloud.queue_delete(never_q);
  let delete_never_ok = cloud.last_error().code() == ErrorCode.OK;

  let create_first = cloud.queue_create(q);
  let create_second = cloud.queue_create(q);
  let create_second_ok = cloud.last_error().code() == ErrorCode.OK;

  let delete_first = cloud.queue_delete(q);

  # Bounded poll until queue_exists(q) is false before testing idempotent second delete (M3)
  let polls = 0;
  while (cloud.queue_exists(q) && polls < 10) {
    polls = polls + 1;
  }

  let delete_second = cloud.queue_delete(q);
  let delete_second_ok = cloud.last_error().code() == ErrorCode.OK;

  lmcode_return_put("delete_never", delete_never);
  lmcode_return_put("delete_never_ok", delete_never_ok);
  lmcode_return_put("create_first", create_first);
  lmcode_return_put("create_second", create_second);
  lmcode_return_put("create_second_ok", create_second_ok);
  lmcode_return_put("delete_first", delete_first);
  lmcode_return_put("delete_second", delete_second);
  lmcode_return_put("delete_second_ok", delete_second_ok);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "02-queue-idempotency host execution failed");
assert(!r.result.delete_never && r.result.delete_never_ok, "queue_delete on never-created queue must return false with ErrorCode.OK");
assert(r.result.create_first, "first queue_create must return true");
assert(!r.result.create_second && r.result.create_second_ok, "second queue_create on existing queue must return false with ErrorCode.OK");
assert(r.result.delete_first, "first queue_delete on existing queue must return true");
assert(!r.result.delete_second && r.result.delete_second_ok, "second queue_delete on already-deleted queue must return false with ErrorCode.OK");
