# Scenario 12: Auth-enforced denial (UNAUTHENTICATED vs PERMISSION_DENIED) on queue operations,
# and queue_exists probe never masquerading a denied queue as exists == false with ErrorCode.OK.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
denied_q = "lmcloud-q12-" + run_id + "-denied";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("queue", ep);
  }
  let q = ${denied_q};
  cloud.set_abort_on_error(false);

  let created = cloud.queue_create(q);
  let create_err = cloud.last_error();

  let enforced = create_err.code() == ErrorCode.UNAUTHENTICATED || create_err.code() == ErrorCode.PERMISSION_DENIED;
  let send_auth_err = true;
  let exists_probe = false;
  let probe_denied_ok = true;

  if (enforced) {
    cloud.queue_send(q, "denied-message");
    let send_err = cloud.last_error();
    send_auth_err = send_err.code() == ErrorCode.UNAUTHENTICATED || send_err.code() == ErrorCode.PERMISSION_DENIED;

    exists_probe = cloud.queue_exists(q);
    let exists_err = cloud.last_error();
    probe_denied_ok = exists_err.code() == ErrorCode.PERMISSION_DENIED || exists_err.code() == ErrorCode.UNAUTHENTICATED;
  } else {
    # Open mode cleanup so the scenario leaves zero state behind when run in open mode
    if (created || cloud.queue_exists(q)) {
      cloud.queue_delete(q);
    }
  }

  lmcode_return_put("enforced", enforced);
  lmcode_return_put("send_auth_err", send_auth_err);
  lmcode_return_put("exists_probe", exists_probe);
  lmcode_return_put("probe_denied_ok", probe_denied_ok);
  lmcode_return_put("clean_in_open_mode", enforced || create_err.code() == ErrorCode.OK);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "12-queue-auth-enforced-denial failed");
assert(r.result.send_auth_err, "queue_send in enforce mode must classify UNAUTHENTICATED or PERMISSION_DENIED");
assert(!r.result.exists_probe, "denied queue must not report exists == true");
assert(r.result.probe_denied_ok, "in enforce mode, queue_exists must set PERMISSION_DENIED or UNAUTHENTICATED, never ErrorCode.OK");
assert(r.result.clean_in_open_mode, "open mode execution must succeed and clean up");
