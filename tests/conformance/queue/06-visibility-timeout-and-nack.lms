# Scenario 06: Visibility timeout hiding of in-flight messages, receipt rotation across queue_nack calls (H1),
# and bounded-poll redelivery after queue_nack(q, receipt, 0) (M1, L2).
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
qname = "lmcloud-q06-" + run_id + "-vis";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("queue", ep);
  }
  let q = ${qname};
  cloud.queue_create(q);

  let payload = "nack-redelivery-payload";
  cloud.queue_send(q, payload);

  # 1. Receive with 30s visibility timeout
  let first = cloud.queue_receive(q, 1, 2, 30);
  let first_len = first.len();
  let r1 = "";
  let first_body = "";
  if (first_len == 1) {
    r1 = first.at(0).receipt();
    first_body = first.at(0).body();
  }

  # 2. While in flight, another receive with wait_seconds = 1 must return 0 messages (L2)
  let while_hidden = cloud.queue_receive(q, 1, 1, 30);
  let hidden_len = while_hidden.len();

  # 3. Extend visibility to 60s and capture the NEW receipt r2 (H1), then nack r2 with visibility_timeout = 0
  let r2 = "";
  let r3 = "";
  if (first_len == 1) {
    r2 = cloud.queue_nack(q, r1, 60);
    r3 = cloud.queue_nack(q, r2, 0);
  }

  # 4. Poll with bounded retries for redelivery (Pub/Sub may take several seconds after modifyAckDeadline(0), M1)
  let redelivered_len = 0;
  let redelivered_body = "";
  let attempts = 0;
  while (redelivered_len == 0 && attempts < 6) {
    attempts = attempts + 1;
    let redelivered = cloud.queue_receive(q, 1, 2, 30);
    redelivered_len = redelivered.len();
    if (redelivered_len == 1) {
      let m2 = redelivered.at(0);
      redelivered_body = m2.body();
      cloud.queue_ack(q, m2.receipt());
    }
  }

  let after_ack = cloud.queue_receive(q, 1, 1, 30);
  let after_ack_len = after_ack.len();

  cloud.queue_delete(q);

  lmcode_return_put("first_ok", first_len == 1 && first_body == payload);
  lmcode_return_put("hidden_len", hidden_len);
  lmcode_return_put("nack_receipts_nonempty", str_len(r2) > 0 && str_len(r3) > 0);
  lmcode_return_put("redelivered_ok", redelivered_len == 1 && redelivered_body == payload);
  lmcode_return_put("after_ack_len", after_ack_len);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "06-visibility-timeout-and-nack host execution failed");
assert(r.result.first_ok, "first queue_receive must return the sent message");
assert(r.result.hidden_len == 0, "in-flight message must be hidden during visibility_timeout");
assert(r.result.nack_receipts_nonempty, "queue_nack must return a non-empty updated receipt string");
assert(r.result.redelivered_ok, "queue_nack(q, r2, 0) must make message eligible for redelivery within bounded poll");
assert(r.result.after_ack_len == 0, "queue must be empty after acknowledging the redelivered message");
