# Scenario 06: Visibility timeout hiding of in-flight messages and immediate redelivery via queue_nack(q, receipt, 0).
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
qname = "lmcloud-q06-" + run_id + "-vis";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("queue", ep);
  }
  let q = ${qname};
  cloud.queue_create(q);

  let payload = "nack-redelivery-payload";
  cloud.queue_send(q, payload);

  # 1. Receive with 30s visibility timeout
  let first = cloud.queue_receive(q, 1, 2, 30);
  let first_len = first.len();
  let first_receipt = "";
  let first_body = "";
  if (first_len == 1) {
    first_receipt = first.at(0).receipt();
    first_body = first.at(0).body();
  }

  # 2. While in flight, another immediate receive must return 0 messages
  let while_hidden = cloud.queue_receive(q, 1, 0, 30);
  let hidden_len = while_hidden.len();

  # 3. Extend visibility to 60s, then nack with visibility_timeout = 0 for immediate redelivery
  if (first_len == 1) {
    cloud.queue_nack(q, first_receipt, 60);
    cloud.queue_nack(q, first_receipt, 0);
  }

  # 4. Receive again: message must be redelivered immediately, then acked
  let redelivered = cloud.queue_receive(q, 1, 2, 30);
  let redelivered_len = redelivered.len();
  let redelivered_body = "";
  if (redelivered_len == 1) {
    let m2 = redelivered.at(0);
    redelivered_body = m2.body();
    cloud.queue_ack(q, m2.receipt());
  }

  let after_ack = cloud.queue_receive(q, 1, 0, 30);
  let after_ack_len = after_ack.len();

  cloud.queue_delete(q);

  lmcode_return_put("first_ok", first_len == 1 && first_body == payload);
  lmcode_return_put("hidden_len", hidden_len);
  lmcode_return_put("redelivered_ok", redelivered_len == 1 && redelivered_body == payload);
  lmcode_return_put("after_ack_len", after_ack_len);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "06-visibility-timeout-and-nack host execution failed");
assert(r.result.first_ok, "first queue_receive must return the sent message");
assert(r.result.hidden_len == 0, "in-flight message must be hidden during visibility_timeout");
assert(r.result.redelivered_ok, "queue_nack(q, receipt, 0) must make message immediately available for redelivery");
assert(r.result.after_ack_len == 0, "queue must be empty after acknowledging the redelivered message");
