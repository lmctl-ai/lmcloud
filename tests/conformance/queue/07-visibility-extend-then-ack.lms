# Scenario 07: Extend visibility via queue_nack, then queue_ack using the returned receipt, then wait past the visibility
# window and verify the message does NOT come back (H1 — proves Azure PopReceipt rotation is honored on subsequent ack).
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
name_prefix = env("LMCLOUD_NAME_PREFIX", "");
qname = len(name_prefix) > 0 ? (name_prefix + "q07-extack") : ("lmcloud-q07-" + run_id + "-extack");

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("queue", ep);
  }
  let q = ${qname};
  cloud.queue_create(q);

  let payload = "extend-then-ack-permanently-deleted";
  cloud.queue_send(q, payload);

  # 1. Receive with a short 2s visibility timeout
  let batch = cloud.queue_receive(q, 1, 2, 2);
  let got_one = batch.len() == 1;
  let new_rcpt = "";
  if (got_one) {
    let old_rcpt = batch.at(0).receipt();
    # 2. Extend visibility (2s) via queue_nack and capture the newly returned receipt (H1)
    new_rcpt = cloud.queue_nack(q, old_rcpt, 2);
    # 3. Acknowledge using the NEW receipt returned by queue_nack
    cloud.queue_ack(q, new_rcpt);
  }
  let ack_ok = cloud.last_error().code() == ErrorCode.OK;

  # 4. Wait past the 2-second visibility window (two 2s long-polls = 4s total) and verify the message does NOT reappear
  let poll1 = cloud.queue_receive(q, 1, 2, 30);
  let poll2 = cloud.queue_receive(q, 1, 2, 30);
  let reappeared = poll1.len() + poll2.len();

  cloud.queue_delete(q);

  lmcode_return_put("got_one", got_one);
  lmcode_return_put("new_rcpt_nonempty", str_len(new_rcpt) > 0);
  lmcode_return_put("ack_ok", ack_ok);
  lmcode_return_put("reappeared", reappeared);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "07-visibility-extend-then-ack host execution failed");
assert(r.result.got_one, "must receive the sent message");
assert(r.result.new_rcpt_nonempty && r.result.ack_ok, "queue_nack must return a valid new receipt that queue_ack accepts");
assert(r.result.reappeared == 0, "message acknowledged with the receipt returned by queue_nack must be permanently deleted and never reappear after visibility expires");
