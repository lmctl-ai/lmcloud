# Scenario 11: Portable 48 KiB (49,152-byte) payload size limit: exact 49,152-byte payload round-trips; 49,153-byte payload fails pre-flight with INVALID_ARGUMENT.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
qname = "lmcloud-q11-" + run_id + "-size";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("queue", ep);
  }
  let q = ${qname};
  cloud.queue_create(q);

  let max_body = str_repeat("a", 49152);
  let over_body = max_body + "z";

  # 1. Pre-flight rejection of 49,153-byte payload
  cloud.set_abort_on_error(false);
  cloud.queue_send(q, over_body);
  let over_err = cloud.last_error();
  let over_rejected = over_err.code() == ErrorCode.INVALID_ARGUMENT && over_err.http_status() == 0;

  # 2. Exact 49,152-byte (48 KiB) payload succeeds and round-trips intact
  cloud.set_abort_on_error(true);
  let sent_id = cloud.queue_send(q, max_body);
  let batch = cloud.queue_receive(q, 1, 2, 30);
  let got_len = batch.len();
  let recv_body_len = 0;
  let recv_matches = false;
  if (got_len == 1) {
    let m = batch.at(0);
    recv_body_len = str_len(m.body());
    recv_matches = m.body() == max_body;
    cloud.queue_ack(q, m.receipt());
  }

  cloud.queue_delete(q);

  lmcode_return_put("over_rejected", over_rejected);
  lmcode_return_put("sent_id_ok", str_len(sent_id) > 0);
  lmcode_return_put("got_len", got_len);
  lmcode_return_put("recv_body_len", recv_body_len);
  lmcode_return_put("recv_matches", recv_matches);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "11-queue-payload-size-guard host execution failed");
assert(r.result.over_rejected, "payload > 49,152 bytes (48 KiB) must fail pre-flight with ErrorCode.INVALID_ARGUMENT");
assert(r.result.sent_id_ok && r.result.got_len == 1, "exact 49,152-byte (48 KiB) payload must be sent and received");
assert(r.result.recv_body_len == 49152 && r.result.recv_matches, "received 48 KiB payload must match sent payload byte-for-byte");
