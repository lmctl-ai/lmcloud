# Requires: function
# Scenario 12: Function cost & performance accounting — integer-nanodollar per-invocation billing units (100 + billed_ms * (memory_mb / 128)), version/alias cleanup reserve coverage, MetricsReport counters/bytes/latency invariants, pre-attempt COST_CAP_EXCEEDED refusal, and teardown immunity on function_delete.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
f_low = "lmf12" + run_id + "lo";
f_high = "lmf12" + run_id + "hi";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("function", ep);
  }
  let fn_lo = ${f_low};
  let fn_hi = ${f_high};

  let code = "def handler(event, context):\n    return {\"echo\": event.get(\"data\", \"\")}\n";

  let cfg_lo = cloud.function_config("python3.12", "index.handler")
    .set_inline_code(code)
    .set_memory_mb(128)
    .set_timeout_seconds(3);
  let cfg_hi = cloud.function_config("python3.12", "index.handler")
    .set_inline_code(code)
    .set_memory_mb(1024)
    .set_timeout_seconds(3);

  let c0 = cloud.estimated_cost();
  cloud.function_create(fn_lo, cfg_lo);
  cloud.function_create(fn_hi, cfg_hi);
  let c1 = cloud.estimated_cost();

  # Publish versions and aliases on fn_lo so teardown exercises incremental version/alias cleanup reserves
  let v1 = cloud.function_publish_version(fn_lo);
  cloud.function_alias_set(fn_lo, "prod", v1);
  cloud.function_alias_set(fn_lo, "canary", v1);

  let req_json = "{\"data\":\"payload-for-cost-accounting\"}";
  let res_lo = cloud.function_invoke(fn_lo, req_json);
  let c2 = cloud.estimated_cost();
  let res_hi = cloud.function_invoke(fn_hi, req_json);
  let c3 = cloud.estimated_cost();

  let expected_bytes = (str_len(req_json) * 2) + str_len(res_lo.payload()) + str_len(res_hi.payload());
  let expected_units = (100 + res_lo.billed_ms() * 1) + (100 + res_hi.billed_ms() * 8);

  let rep1 = cloud.cost_report();
  let create_item = rep1.item("function_create");
  let inv_item = rep1.item("function_invoke");

  let line_items_ok = create_item.service() == "function" &&
                      create_item.requests() >= 2 &&
                      create_item.billing_units() >= 2 &&
                      create_item.estimated_usd() > 0.0 &&
                      inv_item.service() == "function" &&
                      inv_item.requests() == 2 &&
                      inv_item.billing_units() == expected_units &&
                      inv_item.bytes() == expected_bytes &&
                      inv_item.estimated_usd() > 0.0;

  let m = cloud.metrics().op("function_invoke");
  let metrics_ok = m.operation() == "function_invoke" &&
                   m.calls() == 2 &&
                   m.errors() == 0 &&
                   m.bytes_out() == (str_len(req_json) * 2) &&
                   m.bytes_in() == (str_len(res_lo.payload()) + str_len(res_hi.payload())) &&
                   m.min_ms() >= 0.0 &&
                   m.p50_ms() >= m.min_ms() &&
                   m.p95_ms() >= m.p50_ms() &&
                   m.max_ms() >= m.p95_ms() &&
                   m.total_ms() >= m.max_ms();

  # Narrow script work sub-cap to current settled cost so any further function_invoke or version publish is refused pre-flight
  let settled = cloud.estimated_cost();
  cloud.set_cost_cap_usd(settled);
  cloud.set_abort_on_error(false);

  let blocked_inv = cloud.function_invoke(fn_lo, req_json);
  let blocked_err = cloud.last_error();
  let cap_refused_ok = blocked_inv.status_code() == 0 &&
                       blocked_err.code() == ErrorCode.COST_CAP_EXCEEDED &&
                       blocked_err.http_status() == 0 &&
                       cloud.cost_report().cap_exceeded_count() == 1;

  # Teardown immunity: function_delete draws from locked per-function + per-version + per-alias cleanup reserves and succeeds
  let del_lo = cloud.function_delete(fn_lo);
  let del_lo_err = cloud.last_error();
  let del_hi = cloud.function_delete(fn_hi);
  let del_hi_err = cloud.last_error();
  cloud.set_abort_on_error(true);

  let c_end = cloud.estimated_cost();
  let teardown_ok = del_lo && del_lo_err.ok() && del_hi && del_hi_err.ok() && c_end >= settled;

  lmcode_return_put("monotonic_ok", c1 > c0 && c2 > c1 && c3 > c2);
  lmcode_return_put("line_items_ok", line_items_ok);
  lmcode_return_put("metrics_ok", metrics_ok);
  lmcode_return_put("cap_refused_ok", cap_refused_ok);
  lmcode_return_put("teardown_ok", teardown_ok);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "12-function-cost-and-metrics-accounting host execution failed");
assert(r.result.monotonic_ok, "function_create and function_invoke must monotonically increase estimated_cost()");
assert(r.result.line_items_ok, "CostReport function_create and function_invoke items must record exact requests, integer-nanodollar billing units, and payload bytes");
assert(r.result.metrics_ok, "MetricsReport op(function_invoke) must record calls, bytes_out, bytes_in, and monotonic latency quantiles");
assert(r.result.cap_refused_ok, "function_invoke above work sub-cap must fail pre-flight with COST_CAP_EXCEEDED and http_status()==0");
assert(r.result.teardown_ok, "function_delete must tear down function, versions, and aliases under exhausted work sub-cap using locked cleanup reserves");
