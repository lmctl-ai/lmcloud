# Scenario 02: Bucket create idempotency (incl. S3 us-east-1 HEAD-before-PUT), non-empty delete CONFLICT guard, and missing bucket delete idempotency.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
bucket = "lmcloud-c02-" + run_id + "-idem";

setup_and_idem = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("storage", ep);
  }
  let b = ${bucket};
  if (cloud.bucket_exists(b)) {
    cloud.object_delete(b, "guard.txt");
    cloud.bucket_delete(b);
  }

  let first_create = cloud.bucket_create(b);
  let second_create = cloud.bucket_create(b);
  let err_after_second = cloud.last_error();

  cloud.object_put(b, "guard.txt", "keep-bucket-non-empty");

  lmcode_return_put("first_create", first_create);
  lmcode_return_put("second_create", second_create);
  lmcode_return_put("idem_ok", err_after_second.code() == ErrorCode.OK);
end _lmcode_

r1 = run_lmcode(setup_and_idem, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r1.ok, "02 setup and idempotent create failed");
assert(r1.result.first_create, "first bucket_create should return true");
assert(!r1.result.second_create, "second bucket_create on owned bucket should return false");
assert(r1.result.idem_ok, "second bucket_create should leave last_error == ErrorCode.OK");

# Default abort-on-error: deleting a non-empty bucket must abort with [CONFLICT]
nonempty_abort = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("storage", ep);
  }
  cloud.bucket_delete(${bucket});
end _lmcode_

r2 = run_lmcode(nonempty_abort, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(!r2.ok, "deleting a non-empty bucket must fail with CONFLICT");

# Non-abort inspection + cleanup + idempotent delete of already-deleted bucket
cleanup_and_missing = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("storage", ep);
  }
  let b = ${bucket};
  cloud.set_abort_on_error(false);
  let blocked = cloud.bucket_delete(b);
  let conflict_err = cloud.last_error();

  cloud.set_abort_on_error(true);
  cloud.object_delete(b, "guard.txt");
  let first_del = cloud.bucket_delete(b);
  let second_del = cloud.bucket_delete(b);
  let err_after_missing_del = cloud.last_error();

  lmcode_return_put("blocked", blocked);
  lmcode_return_put("is_conflict", conflict_err.code() == ErrorCode.CONFLICT);
  lmcode_return_put("first_del", first_del);
  lmcode_return_put("second_del", second_del);
  lmcode_return_put("missing_del_ok", err_after_missing_del.code() == ErrorCode.OK);
end _lmcode_

r3 = run_lmcode(cleanup_and_missing, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r3.ok, "02 cleanup and missing-bucket delete failed");
assert(!r3.result.blocked && r3.result.is_conflict, "non-empty bucket_delete must report ErrorCode.CONFLICT");
assert(r3.result.first_del, "cleaning empty bucket should succeed");
assert(!r3.result.second_del && r3.result.missing_del_ok, "deleting an already-deleted bucket should return false with ErrorCode.OK");
