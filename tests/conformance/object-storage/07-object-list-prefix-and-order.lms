# Scenario 07: Object list with prefix filtering and lexicographical UTF-8 key order.
# Providers may return fewer than max_keys per page (design 02 §7, M7), so every listing
# follows next_token until !has_more() instead of assuming one page holds all keys.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
bucket = "lmcloud-c07-" + run_id + "-prefix";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("storage", ep);
  }
  let b = ${bucket};

  if (cloud.bucket_exists(b)) {
    cloud.object_delete(b, "logs/2026/a.txt");
    cloud.object_delete(b, "logs/2026/b.txt");
    cloud.object_delete(b, "logs/2025/c.txt");
    cloud.object_delete(b, "root.txt");
    cloud.bucket_delete(b);
  }
  cloud.bucket_create(b);

  # Insert out of lexicographical order to verify sorted output
  cloud.object_put(b, "root.txt", "root-body");
  cloud.object_put(b, "logs/2026/b.txt", "b26");
  cloud.object_put(b, "logs/2025/c.txt", "c25");
  cloud.object_put(b, "logs/2026/a.txt", "a26");

  # Prefix listing: follow every page (bounded) and keep the first summary for field checks.
  let sub_keys = str_list();
  let first_key = "";
  let first_size = -1;
  let first_etag_ok = false;
  let token = "";
  let more = true;
  let pages = 0;
  while (more && pages < 100) {
    let page = cloud.object_list(b, "logs/2026/", 0, token);
    pages = pages + 1;
    for (item in page) {
      if (str_len(first_key) == 0) {
        first_key = item.key();
        first_size = item.size();
        first_etag_ok = str_len(item.etag()) > 0;
      }
      sub_keys.add(item.key());
    }
    more = page.has_more();
    token = page.next_token();
  }

  # Full listing: same pagination loop with an empty prefix.
  let all_keys = str_list();
  token = "";
  more = true;
  pages = 0;
  while (more && pages < 100) {
    let page = cloud.object_list(b, "", 0, token);
    pages = pages + 1;
    for (item in page) {
      all_keys.add(item.key());
    }
    more = page.has_more();
    token = page.next_token();
  }

  let sub_joined = sub_keys.join(",");
  let all_joined = all_keys.join(",");

  cloud.object_delete(b, "logs/2026/a.txt");
  cloud.object_delete(b, "logs/2026/b.txt");
  cloud.object_delete(b, "logs/2025/c.txt");
  cloud.object_delete(b, "root.txt");
  cloud.bucket_delete(b);

  lmcode_return_put("sub_len", sub_keys.len());
  lmcode_return_put("sub_joined", sub_joined);
  lmcode_return_put("all_len", all_keys.len());
  lmcode_return_put("all_joined", all_joined);
  lmcode_return_put("first_key", first_key);
  lmcode_return_put("first_size", first_size);
  lmcode_return_put("first_etag_ok", first_etag_ok);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "07-object-list-prefix-and-order failed");
assert(r.result.sub_len == 2, "prefix logs/2026/ should match 2 objects");
assert(r.result.sub_joined == "logs/2026/a.txt,logs/2026/b.txt", "prefix list must be sorted lexicographically");
assert(r.result.all_len == 4, "empty prefix should match all 4 objects");
assert(r.result.all_joined == "logs/2025/c.txt,logs/2026/a.txt,logs/2026/b.txt,root.txt", "full list must be sorted lexicographically");
assert(r.result.first_key == "logs/2026/a.txt" && r.result.first_size == 3 && r.result.first_etag_ok, "ObjectSummary fields must be populated");
