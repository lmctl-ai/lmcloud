# Requires: userpool
# Scenario 05: Sign-in failure semantics + secret redaction — wrong password and missing user both
# fail with UNAUTHENTICATED carrying the SAME generic message (no user-enumeration leak), and the
# message never contains the wrong password (redaction contract, design 17 §2.6).
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
pool = "lmu05" + run_id + "a";
user = "user05_" + run_id + "_cid";
good_pw = "Mm4" + "x8Lp" + run_id + "zz";
bad_pw = "W1" + "rongpass-never-echo-" + run_id;

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("userpool", ep);
  }
  let p = ${pool};
  let u = ${user};
  cloud.userpool_create(p);
  cloud.user_create(p, u);
  cloud.user_set_password(p, u, ${good_pw});

  cloud.set_abort_on_error(false);
  cloud.user_sign_in(p, u, ${bad_pw});
  let e_bad = cloud.last_error();
  cloud.user_sign_in(p, "user05_zz_ghost", ${bad_pw});
  let e_ghost = cloud.last_error();

  let bad_unauth = e_bad.code() == ErrorCode.UNAUTHENTICATED;
  let ghost_unauth = e_ghost.code() == ErrorCode.UNAUTHENTICATED;
  let no_pw_echo = !str_contains(e_bad.message(), ${bad_pw}) && !str_contains(e_ghost.message(), ${bad_pw});
  let same_msg = e_bad.message() == e_ghost.message();

  cloud.set_abort_on_error(true);
  cloud.user_delete(p, u);
  cloud.userpool_delete(p);

  lmcode_return_put("bad_unauth", bad_unauth);
  lmcode_return_put("ghost_unauth", ghost_unauth);
  lmcode_return_put("no_pw_echo", no_pw_echo);
  lmcode_return_put("same_msg", same_msg);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "05 host execution failed");
assert(r.result.bad_unauth && r.result.ghost_unauth, "wrong password and missing user are both UNAUTHENTICATED");
assert(r.result.no_pw_echo, "error messages must never contain the attempted password");
assert(r.result.same_msg, "wrong-password and missing-user messages must be identical (no user enumeration)");
