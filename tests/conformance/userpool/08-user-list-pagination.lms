# Requires: userpool
# Scenario 08: user_list pagination — seed 5 users, walk pages of max_items=2, collect exactly the 5
# usernames ascending with zero duplicates/gaps; empty page with token is followed; final token "".
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
pool = "lmu08" + run_id + "a";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("userpool", ep);
  }
  let p = ${pool};
  cloud.userpool_create(p);

  let names = str_list().add("user08_a").add("user08_b").add("user08_c").add("user08_d").add("user08_e");
  let i = 0;
  while (i < names.len()) {
    cloud.user_create(p, names.at(i));
    i = i + 1;
  }

  # restart-per-poll walk (aggregate view; bounded). Uniqueness asserted AS ITEMS ARRIVE (not after
  # dedup), and the token invariant is checked on EVERY page.
  let collected = str_list();
  let attempt = 0;
  let completed = false;
  let dup_seen = false;
  let invariant_ok = true;
  while (!completed && attempt < 12) {
    attempt = attempt + 1;
    collected = str_list();
    let tok = "";
    let done_walk = false;
    let guard = 0;
    while (!done_walk && guard < 20) {
      guard = guard + 1;
      let page = cloud.user_list(p, 2, tok);
      # token invariant per page
      if (page.has_more() != (str_len(page.next_token()) > 0)) { invariant_ok = false; }
      let j = 0;
      while (j < page.len()) {
        let un = page.at(j).username();
        if (collected.contains(un)) { dup_seen = true; } else { collected = collected.add(un); }
        j = j + 1;
      }
      if (page.has_more()) {
        tok = page.next_token();
      } else {
        done_walk = true;
      }
    }
    if (done_walk && collected.len() == 5) { completed = true; }
  }

  let order_ok = collected.len() == 5
    && collected.at(0) == "user08_a"
    && collected.at(1) == "user08_b"
    && collected.at(2) == "user08_c"
    && collected.at(3) == "user08_d"
    && collected.at(4) == "user08_e";

  cloud.set_abort_on_error(false);
  cloud.user_list(p, 501, "");
  let e_hi = cloud.last_error();
  cloud.user_list(p, -1, "");
  let e_lo = cloud.last_error();
  let bounds_ok = e_hi.code() == ErrorCode.INVALID_ARGUMENT && e_hi.http_status() == 0
    && e_lo.code() == ErrorCode.INVALID_ARGUMENT && e_lo.http_status() == 0;
  cloud.set_abort_on_error(true);

  let k = 0;
  while (k < 5) {
    cloud.user_delete(p, names.at(k));
    k = k + 1;
  }
  cloud.userpool_delete(p);

  lmcode_return_put("completed", completed);
  lmcode_return_put("order_ok", order_ok);
  lmcode_return_put("bounds_ok", bounds_ok);
  lmcode_return_put("dup_seen", dup_seen);
  lmcode_return_put("invariant_ok", invariant_ok);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "08 host execution failed");
assert(r.result.completed, "pagination walk completes with all 5 users (deduplicated)");
assert(!r.result.dup_seen, "duplicate page entries detected as they arrive (none allowed)");
assert(r.result.order_ok, "usernames ascending with no duplicates/gaps");
assert(r.result.invariant_ok, "token invariant holds on every page: has_more() iff next_token() != \"\"");
assert(r.result.bounds_ok, "max_items outside 0..500 fails pre-flight INVALID_ARGUMENT");
