# Requires: userpool
# Scenario 04: set permanent password; sign_in yields a Session with non-empty opaque access token,
# expires_in in 1..3600, claims carrying sub/username/iat/exp; two sign-ins both valid.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
pool = "lmu04" + run_id + "a";
user = "user04_" + run_id + "_bob";
password = "Zz7" + "k9Qw" + run_id + "pass";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("userpool", ep);
  }
  let p = ${pool};
  let u = ${user};
  cloud.userpool_create(p);
  cloud.user_create(p, u);

  cloud.user_set_password(p, u, ${password});

  let s1 = cloud.user_sign_in(p, u, ${password});
  let t1 = s1.access_token();
  let tok_ok = str_len(t1) > 0;
  let exp_ok = s1.expires_in() >= 1 && s1.expires_in() <= 3600;
  let c = s1.claims();
  let claims_ok = str_len(c.get("sub")) > 0 && c.get("username") == u && str_len(c.get("iat")) > 0 && str_len(c.get("exp")) > 0;

  let s2 = cloud.user_sign_in(p, u, ${password});
  let both_valid = str_len(s2.access_token()) > 0 && s2.expires_in() >= 1;

  cloud.user_delete(p, u);
  cloud.userpool_delete(p);

  lmcode_return_put("tok_ok", tok_ok);
  lmcode_return_put("exp_ok", exp_ok);
  lmcode_return_put("claims_ok", claims_ok);
  lmcode_return_put("both_valid", both_valid);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "04-user-password-and-signin host execution failed");
assert(r.result.tok_ok, "sign_in returns a non-empty access token");
assert(r.result.exp_ok, "expires_in within 1..3600");
assert(r.result.claims_ok, "claims contain sub, username, iat, exp");
assert(r.result.both_valid, "repeated sign-in also yields a valid session");
