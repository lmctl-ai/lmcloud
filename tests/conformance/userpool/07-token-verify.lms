# Requires: userpool
# Scenario 07: Token verification — valid token verifies with claims; MID-SIGNATURE-byte tamper
# rejected; hand-crafted alg:none token rejected; cross-pool rejected; verify error messages never
# contain the exact token string that was supplied (neither original nor tampered).
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
pool_a = "lmu07" + run_id + "a";
pool_b = "lmu07" + run_id + "b";
user = "user07_" + run_id + "_eve";
password = "Bb9" + "t4Xs" + run_id + "pw";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("userpool", ep);
  }
  let pa = ${pool_a};
  let pb = ${pool_b};
  let u = ${user};
  cloud.userpool_create(pa);
  cloud.userpool_create(pb);
  cloud.user_create(pa, u);
  cloud.user_set_password(pa, u, ${password});
  let s = cloud.user_sign_in(pa, u, ${password});
  let tok = s.access_token();

  let v = cloud.user_verify_token(pa, tok);
  let claims = v.claims();
  let claims_ok = claims.get("username") == u && str_len(claims.get("sub")) > 0 && str_len(v.access_token()) > 0 && v.expires_in() >= 1;

  # Tamper INSIDE the signature segment (not padding): flip a character in the middle of part[2]
  let parts = str_split(tok, ".");
  let sig = parts.at(2);
  let mid = str_substr(sig, str_len(sig) / 2, 1);
  let flip = "B";
  if (mid == "B") { flip = "C"; }
  let bad_sig = str_substr(sig, 0, str_len(sig) / 2) + flip + str_substr(sig, str_len(sig) / 2 + 1, str_len(sig) - str_len(sig) / 2 - 1);
  let bad_tok = parts.at(0) + "." + parts.at(1) + "." + bad_sig;

  # Hand-crafted WELL-FORMED alg:none token (base64url, no padding, numeric iat/exp, valid iss/aud
  # aimed at THIS pool): isolates algorithm rejection as a trust failure (UNAUTHENTICATED), not
  # structural garbage and not a clock artifact.
  let h = str_base64_encode("{\"alg\":\"none\",\"typ\":\"JWT\"}");
  let h64 = str_replace(str_replace(str_replace(h, "+", "-"), "/", "_"), "=", "");
  let iat_now = 1000;   # any integral reasonable iat; trust rejection must not depend on clock
  let py = str_base64_encode("{\"iss\":\"sim-issuer\",\"aud\":\"" + pa + "\",\"sub\":\"attacker-sub\",\"username\":\"" + u + "\",\"iat\":" + str(iat_now) + ",\"exp\":9999999999}");
  let p64 = str_replace(str_replace(str_replace(py, "+", "-"), "/", "_"), "=", "");
  let alg_none = h64 + "." + p64 + ".";

  cloud.set_abort_on_error(false);
  cloud.user_verify_token(pa, bad_tok);
  let e_tam = cloud.last_error();
  let tam_unauth = e_tam.code() == ErrorCode.UNAUTHENTICATED;
  let no_echo_orig = !str_contains(e_tam.message(), tok);
  let no_echo_bad = !str_contains(e_tam.message(), bad_tok);

  cloud.user_verify_token(pa, alg_none);
  let e_alg = cloud.last_error();
  let alg_unauth = e_alg.code() == ErrorCode.UNAUTHENTICATED && !str_contains(e_alg.message(), alg_none);

  cloud.user_verify_token(pb, tok);   # pool-A token under pool B (audience/incarnation isolation)
  let e_cross = cloud.last_error();
  let cross_unauth = e_cross.code() == ErrorCode.UNAUTHENTICATED;
  cloud.set_abort_on_error(true);

  cloud.user_delete(pa, u);
  cloud.userpool_delete(pa);
  cloud.userpool_delete(pb);

  lmcode_return_put("claims_ok", claims_ok);
  lmcode_return_put("tam_unauth", tam_unauth);
  lmcode_return_put("no_echo", no_echo_orig && no_echo_bad);
  lmcode_return_put("alg_unauth", alg_unauth);
  lmcode_return_put("cross_unauth", cross_unauth);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "07 host execution failed");
assert(r.result.claims_ok, "valid token verifies with sub/username claims and remaining expires_in >= 1");
assert(r.result.tam_unauth, "signature-segment tamper must reject");
assert(r.result.no_echo, "verify error must contain neither the original nor the tampered token");
assert(r.result.alg_unauth, "alg:none tokens must reject");
assert(r.result.cross_unauth, "cross-pool token must be rejected");
