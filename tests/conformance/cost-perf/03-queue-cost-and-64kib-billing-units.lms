# Scenario 03: Queue cost metering, 64 KiB chunk billing units, and byte tracking across send/receive/nack/ack with at-least-once deduplication.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
qname = "lmcloud-cp03-" + run_id + "-q";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("all", ep);
  }
  let q = ${qname};

  let created = cloud.queue_create(q);
  let c_after_create = cloud.estimated_cost();

  let msg1 = "alpha-message";
  let msg2 = "beta-message-payload";
  let id1 = cloud.queue_send(q, msg1);
  let id2 = cloud.queue_send(q, msg2);
  let c_after_send = cloud.estimated_cost();

  let seen_ids = qw();
  let unique_bytes = 0;
  let delivered_bytes = 0;
  let deliveries = 0;
  let attempts = 0;
  while (seen_ids.len() < 2 && attempts < 10) {
    let batch = cloud.queue_receive(q, 2, 1, 30);
    let idx = 0;
    while (idx < batch.len()) {
      let m = batch.at(idx);
      let b_len = str_len(m.body());
      delivered_bytes = delivered_bytes + b_len;
      deliveries = deliveries + 1;
      if (!seen_ids.contains(m.id())) {
        seen_ids.add(m.id());
        unique_bytes = unique_bytes + b_len;
      }
      let next_rcpt = cloud.queue_nack(q, m.receipt(), 20);
      cloud.queue_ack(q, next_rcpt);
      idx = idx + 1;
    }
    attempts = attempts + 1;
  }

  let deleted = cloud.queue_delete(q);
  let rep = cloud.cost_report();
  let qcreate_it = rep.item("queue_create");
  let qsend_it = rep.item("queue_send");
  let qrecv_it = rep.item("queue_receive");
  let qnack_it = rep.item("queue_nack");
  let qack_it = rep.item("queue_ack");

  let expected_bytes = str_len(msg1) + str_len(msg2);

  lmcode_return_put("created_and_deleted", created && deleted && str_len(id1) > 0 && str_len(id2) > 0);
  lmcode_return_put("acked_both", seen_ids.len() == 2 && unique_bytes == expected_bytes && delivered_bytes >= expected_bytes);
  lmcode_return_put("cost_increased", c_after_create > 0.0 && c_after_send > c_after_create && rep.estimated_usd() >= c_after_send);
  lmcode_return_put("qcreate_ok", qcreate_it.service() == "queue" && qcreate_it.requests() >= 1 && qcreate_it.billing_units() >= 1);
  lmcode_return_put("qsend_ok", qsend_it.service() == "queue" && qsend_it.requests() == 2 && qsend_it.billing_units() == 2 && qsend_it.bytes() == expected_bytes);
  lmcode_return_put("qrecv_ok", qrecv_it.service() == "queue" && qrecv_it.requests() >= 1 && qrecv_it.billing_units() >= 1 && qrecv_it.bytes() == delivered_bytes);
  lmcode_return_put("qnack_ack_ok", qnack_it.requests() == deliveries && qack_it.requests() == deliveries && deliveries >= 2);
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "03-queue-cost-and-64kib-billing-units failed");
assert(r.result.created_and_deleted, "queue_create, queue_send, and queue_delete must succeed");
assert(r.result.acked_both, "both unique sent messages must be received, nacked, and acked");
assert(r.result.cost_increased, "queue operations must increase estimated_cost()");
assert(r.result.qcreate_ok, "queue_create line item must record service=='queue' and >= 1 request");
assert(r.result.qsend_ok, "queue_send line item must record 2 requests, 2 64KiB billing units, and exact bytes");
assert(r.result.qrecv_ok, "queue_receive line item must record exact delivered bytes");
assert(r.result.qnack_ack_ok, "queue_nack and queue_ack line items must match actual delivery count");
