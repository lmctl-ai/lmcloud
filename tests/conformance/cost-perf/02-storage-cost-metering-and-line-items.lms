# Scenario 02: Storage cost metering, per-operation CostLineItem breakdown, monotonic byte pricing, and no refund on delete.
endpoint = len(ARGV) > 1 ? ARGV[1] : "";
run_id = len(ARGV) > 2 && len(ARGV[2]) > 0 ? ARGV[2] : "r0";
bkt = "lmcloud-cp02-" + run_id + "-bkt";

program = _lmcode_ schema="../../../schema/lmcloud.dsl.json";
  let ep = ${endpoint};
  if (str_len(ep) > 0) {
    cloud.set_endpoint("all", ep);
  }
  let b = ${bkt};

  let c0 = cloud.estimated_cost();
  cloud.bucket_create(b);
  let c1 = cloud.estimated_cost();

  let small_body = "hello-cost";
  cloud.object_put(b, "small.txt", small_body);
  let c2 = cloud.estimated_cost();

  let large_body = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  let i = 0;
  while (i < 6) {
    large_body = large_body + large_body;
    i = i + 1;
  }
  cloud.object_put(b, "large.txt", large_body);
  let c3 = cloud.estimated_cost();

  let head_meta = cloud.object_head(b, "small.txt");
  let got_small = cloud.object_get(b, "small.txt");
  let page = cloud.object_list(b, "");
  let c4 = cloud.estimated_cost();

  # Deleting objects and buckets must NEVER refund accrued estimated cost
  cloud.object_delete(b, "small.txt");
  cloud.object_delete(b, "large.txt");
  cloud.bucket_delete(b);
  let c5 = cloud.estimated_cost();

  let rep = cloud.cost_report();
  let put_item = rep.item("object_put");
  let get_item = rep.item("object_get");
  let head_item = rep.item("object_head");
  let bcreate_item = rep.item("bucket_create");

  # Verify sorted line items and sum of line items equals rep.estimated_usd()
  let sum_items = 0.0;
  let sum_reqs = 0;
  let sorted_ok = true;
  let prev_op = "";
  let idx = 0;
  while (idx < rep.len()) {
    let it = rep.at(idx);
    if (idx > 0 && str_cmp(prev_op, it.operation()) >= 0) {
      sorted_ok = false;
    }
    prev_op = it.operation();
    sum_items = sum_items + it.estimated_usd();
    sum_reqs = sum_reqs + it.requests();
    idx = idx + 1;
  }

  assert_close(sum_items, rep.estimated_usd(), 1e-8);
  assert_close(c5, rep.estimated_usd(), 1e-9);

  let expected_put_bytes = str_len(small_body) + str_len(large_body);
  let expected_get_bytes = str_len(got_small);

  lmcode_return_put("monotonic_create", c1 > c0);
  lmcode_return_put("monotonic_put1", c2 > c1);
  lmcode_return_put("monotonic_put2", c3 > c2);
  lmcode_return_put("larger_put_costs_more", (c3 - c2) >= (c2 - c1));
  lmcode_return_put("monotonic_reads", c4 > c3);
  lmcode_return_put("no_refund_on_delete", c5 >= c4);
  lmcode_return_put("head_ok", head_meta.exists() && page.len() == 2);
  lmcode_return_put("bcreate_item_ok", bcreate_item.service() == "storage" && bcreate_item.requests() == 1 && bcreate_item.billing_units() == 1 && bcreate_item.estimated_usd() > 0.0);
  lmcode_return_put("put_item_ok", put_item.service() == "storage" && put_item.requests() == 2 && put_item.billing_units() == 2 && put_item.bytes() == expected_put_bytes && put_item.byte_price_usd_per_gib() > 0.0);
  lmcode_return_put("get_item_ok", get_item.requests() == 1 && get_item.bytes() == expected_get_bytes);
  lmcode_return_put("head_item_ok", head_item.requests() == 1 && head_item.bytes() == 0);
  lmcode_return_put("sorted_and_totals_ok", sorted_ok && sum_reqs == rep.total_requests() && rep.total_bytes() == (expected_put_bytes + expected_get_bytes));
end _lmcode_

r = run_lmcode(program, {command:[ARGV[0], "--lmcode", "$DSLFILE"]});
assert(r.ok, "02-storage-cost-metering-and-line-items failed");
assert(r.result.monotonic_create, "bucket_create must increase estimated_cost()");
assert(r.result.monotonic_put1 && r.result.monotonic_put2, "object_put must increase estimated_cost()");
assert(r.result.larger_put_costs_more, "larger object_put payload must cost at least as much as smaller payload");
assert(r.result.monotonic_reads, "object_head/get/list must increase estimated_cost()");
assert(r.result.no_refund_on_delete, "deleting objects and buckets must never refund estimated_cost()");
assert(r.result.head_ok, "object_head and object_list should succeed");
assert(r.result.bcreate_item_ok, "bucket_create CostLineItem must record 1 request and 1 billing unit");
assert(r.result.put_item_ok, "object_put CostLineItem must record 2 requests, 2 units, and exact payload bytes");
assert(r.result.get_item_ok, "object_get CostLineItem must record 1 request and exact downloaded bytes");
assert(r.result.head_item_ok, "object_head CostLineItem must record 1 request and 0 payload bytes");
assert(r.result.sorted_and_totals_ok, "CostReport items must be sorted and match total_requests/total_bytes");
