# Pattern: Sensitive output masking, nonsensitive() casts, and state inspection.
# Demonstrates protecting secrets with sensitive = true output declarations,
# inspecting unmasked values via show_state(), and computing derived nonsensitive metadata.

out = ARGV.len() > 0 ? ARGV[0] : "build/16-sensitive-outputs.dslb";
mkdir("build");
workdir = "build/ex16-workdir";
mkdir(workdir);

tf = "resource \"random_password\" \"api_secret\" {\n" +
     "  length  = 24\n" +
     "  special = false\n" +
     "}\n\n" +
     "resource \"local_file\" \"unmasked_cert\" {\n" +
     "  filename = \"${path.module}/public.key\"\n" +
     "  content  = \"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPublicKeyData\"\n" +
     "}\n\n" +
     "output \"db_password\" {\n" +
     "  value     = random_password.api_secret.result\n" +
     "  sensitive = true\n" +
     "}\n\n" +
     "output \"public_key\" {\n" +
     "  value = local_file.unmasked_cert.content\n" +
     "}\n\n" +
     "output \"password_length\" {\n" +
     "  value = length(nonsensitive(random_password.api_secret.result))\n" +
     "}\n";
write_file(path_join(workdir, "main.tf"), tf);

p = _dsl_ cli="lmcloud";
let dir = "build/ex16-workdir";
let ok_init = tofu.init(dir);
let plan = tofu.plan(dir);
let adds = plan.add();
let ok_apply = tofu.apply(dir);
let pub = tofu.output(dir, "public_key");
let sec = tofu.output(dir, "db_password");
let pw_len = tofu.output(dir, "password_length");
let state_json = tofu.show_state(dir);
let ok_destroy = tofu.destroy(dir);
end _dsl_

savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 60000);
assert(r.code == 0, "host execution failed: " + r.stderr);
assert(starts_with(r.stdout, "{\"ok\": true"), "expected ok json output");

println("ok 16-sensitive-outputs - managed masked sensitive outputs and state introspection");
