# Pattern: Static timestamps and periodic rotation triggers.
# Demonstrates time_static for fixed temporal anchors and time_rotating
# for scheduling key rotations and periodic certificate refreshes.

out = ARGV.len() > 0 ? ARGV[0] : "build/09-time-lifecycle.dslb";
mkdir("build");
workdir = "build/ex09-workdir";
mkdir(workdir);

tf = "resource \"time_static\" \"baseline\" {\n" +
     "  rfc3339 = \"2026-01-01T00:00:00Z\"\n" +
     "}\n\n" +
     "resource \"time_rotating\" \"rotation\" {\n" +
     "  rotation_days = 30\n" +
     "}\n\n" +
     "output \"static_rfc3339\" {\n" +
     "  value = time_static.baseline.rfc3339\n" +
     "}\n\n" +
     "output \"rotation_rfc3339\" {\n" +
     "  value = time_rotating.rotation.rfc3339\n" +
     "}\n";
write_file(path_join(workdir, "main.tf"), tf);

p = _lmcode_ cli="lmcloud";
let dir = "build/ex09-workdir";
let ok_init = tofu.init(dir);
let plan = tofu.plan(dir);
let adds = plan.add();
let ok_apply = tofu.apply(dir);
let ts = tofu.output(dir, "static_rfc3339");
let rot = tofu.output(dir, "rotation_rfc3339");
let state_json = tofu.show_state(dir);
let ok_destroy = tofu.destroy(dir);
end _lmcode_

savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 60000);
assert(r.code == 0, "host execution failed: " + r.stderr);
assert(starts_with(r.stdout, "{\"ok\": true"), "expected ok json output");

println("ok 09-time-lifecycle - managed static timestamps and rotation schedules");
