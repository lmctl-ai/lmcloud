# Pattern: Directory packaging into ZIP archives.
# Demonstrates creating deterministic zip archives of application source trees
# using the embedded archive provider for offline artifact bundling.

out = ARGV.len() > 0 ? ARGV[0] : "build/11-archive-zip.dslb";
mkdir("build");
workdir = "build/ex11-workdir";
mkdir(workdir);
srcdir = path_join(workdir, "src");
mkdir(srcdir);

write_file(path_join(srcdir, "index.js"), "exports.handler = async () => ({ statusCode: 200 });\n");
write_file(path_join(srcdir, "package.json"), "{\"name\": \"service\", \"version\": \"1.0.0\"}\n");

tf = "data \"archive_file\" \"bundle\" {\n" +
     "  type        = \"zip\"\n" +
     "  source_dir  = \"${path.module}/src\"\n" +
     "  output_path = \"${path.module}/bundle.zip\"\n" +
     "}\n\n" +
     "output \"archive_sha256\" {\n" +
     "  value = data.archive_file.bundle.output_sha256\n" +
     "}\n\n" +
     "output \"archive_size\" {\n" +
     "  value = data.archive_file.bundle.output_size\n" +
     "}\n";
write_file(path_join(workdir, "main.tf"), tf);

p = _lmcode_ cli="lmcloud";
let dir = "build/ex11-workdir";
let ok_init = tofu.init(dir);
let plan = tofu.plan(dir);
let ok_apply = tofu.apply(dir);
let hash = tofu.output(dir, "archive_sha256");
let sz = tofu.output(dir, "archive_size");
let state_json = tofu.show_state(dir);
let ok_destroy = tofu.destroy(dir);
end _lmcode_

savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 60000);
assert(r.code == 0, "host execution failed: " + r.stderr);
assert(starts_with(r.stdout, "{\"ok\": true"), "expected ok json output");

println("ok 11-archive-zip - packaged directory into ZIP archive with SHA256 verification");
