# Pattern: Modular infrastructure composition via local module source.
# Demonstrates local module directory references, module initialization,
# and passing inputs/outputs across module boundaries.

out = ARGV.len() > 0 ? ARGV[0] : "build/06-local-module.dslb";
mkdir("build");
workdir = "build/ex06-workdir";
moddir = "build/ex06-workdir/modules/subservice";
mkdir(moddir);

submodule_tf = "variable \"service_name\" {\n  type = string\n}\nresource \"terraform_data\" \"service\" {\n  input = \"service-${var.service_name}\"\n}\noutput \"service_id\" {\n  value = terraform_data.service.output\n}\n";
write_file(path_join(moddir, "main.tf"), submodule_tf);

root_tf = "module \"auth\" {\n  source       = \"./modules/subservice\"\n  service_name = \"authentication\"\n}\noutput \"auth_id\" {\n  value = module.auth.service_id\n}\n";
write_file(path_join(workdir, "main.tf"), root_tf);

p = _lmcode_ cli="lmcloud";
let dir = "build/ex06-workdir";
let ok_init = tofu.init(dir);
let plan = tofu.plan(dir);
let ok_apply = tofu.apply(dir);
let auth_id = tofu.output(dir, "auth_id");
let ok_destroy = tofu.destroy(dir);
end _lmcode_

savedsl(p, out);
r = system(concat(dsl_cli(p), ["--lmcode", out]), 60000);
assert(r.code == 0, "host execution failed: " + r.stderr);
assert(starts_with(r.stdout, "{\"ok\": true"), "expected ok json output");

println("ok 06-local-module - initialized and evaluated local submodule hierarchy");
