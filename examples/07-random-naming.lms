# Pattern: Cryptographic random naming and credential generation.
# Demonstrates offline generation of unique pet names, passwords, and identifiers
# using the embedded random provider with zero network or external plugins.

out = ARGV.len() > 0 ? ARGV[0] : "build/07-random-naming.dslb";
mkdir("build");
workdir = "build/ex07-workdir";
mkdir(workdir);

tf = "resource \"random_pet\" \"server\" {\n" +
     "  length    = 2\n" +
     "  separator = \"-\"\n" +
     "}\n" +
     "resource \"random_password\" \"db_password\" {\n" +
     "  length  = 16\n" +
     "  special = false\n" +
     "}\n" +
     "resource \"random_id\" \"cluster\" {\n" +
     "  byte_length = 4\n" +
     "}\n" +
     "output \"server_name\" {\n" +
     "  value = random_pet.server.id\n" +
     "}\n" +
     "output \"cluster_hex\" {\n" +
     "  value = random_id.cluster.hex\n" +
     "}\n" +
     "output \"db_password\" {\n" +
     "  value     = random_password.db_password.result\n" +
     "  sensitive = true\n" +
     "}\n";
write_file(path_join(workdir, "main.tf"), tf);

p = _lmcode_ cli="lmcloud";
let dir = "build/ex07-workdir";
let ok_init = tofu.init(dir);
let plan = tofu.plan(dir);
let adds = plan.add();
let ok_apply = tofu.apply(dir);
let server = tofu.output(dir, "server_name");
let cluster = tofu.output(dir, "cluster_hex");
let state_json = tofu.show_state(dir);
let ok_destroy = tofu.destroy(dir);
end _lmcode_

savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 60000);
assert(r.code == 0, "host execution failed: " + r.stderr);
assert(starts_with(r.stdout, "{\"ok\": true"), "expected ok json output");

println("ok 07-random-naming - generated offline server pet names, passwords, and cluster IDs");
