# Pattern: Resource scaling and iteration with count and for_each.
# Demonstrates multi-instance resource definitions and inspecting multi-resource plan counts.

out = ARGV.len() > 0 ? ARGV[0] : "build/05-count-and-for-each.dslb";
mkdir("build");
workdir = "build/ex05-workdir";
mkdir(workdir);

tf = "resource \"terraform_data\" \"servers\" {\n  count = 3\n  input = \"srv-${count.index}\"\n}\nresource \"terraform_data\" \"roles\" {\n  for_each = toset([\"api\", \"worker\", \"cache\"])\n  input    = each.key\n}\noutput \"server_count\" {\n  value = length(terraform_data.servers)\n}\n";
write_file(path_join(workdir, "main.tf"), tf);

p = _dsl_ cli="lmcloud";
let dir = "build/ex05-workdir";
let ok_init = tofu.init(dir);
let plan = tofu.plan(dir);
let adds = plan.add();
let ok_apply = tofu.apply(dir);
let count_out = tofu.output(dir, "server_count");
let ok_destroy = tofu.destroy(dir);
end _dsl_

savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 60000);
assert(r.code == 0, "host execution failed: " + r.stderr);
assert(starts_with(r.stdout, "{\"ok\": true"), "expected ok json output");

println("ok 05-count-and-for-each - scaled resources via count and for_each");
