# Pattern: Dynamic input variable injection and local expression computation.
# Demonstrates setting input variables programmatically via tofu.var() before plan/apply,
# and reading resolved outputs derived from locals and variables.

out = ARGV.len() > 0 ? ARGV[0] : "build/04-variables-and-locals.dslb";
mkdir("build");
workdir = "build/ex04-workdir";
mkdir(workdir);

tf = "variable \"tier\" {\n  type = string\n}\nvariable \"region\" {\n  type = string\n}\nlocals {\n  fqdn = \"${var.tier}.${var.region}.cloud.internal\"\n}\nresource \"terraform_data\" \"endpoint\" {\n  input = local.fqdn\n}\noutput \"endpoint_fqdn\" {\n  value = terraform_data.endpoint.output\n}\n";
write_file(path_join(workdir, "main.tf"), tf);

p = _dsl_ cli="lmcloud";
let dir = "build/ex04-workdir";
tofu.var("tier", "prod");
tofu.var("region", "us-east");
let ok_init = tofu.init(dir);
let plan = tofu.plan(dir);
let ok_apply = tofu.apply(dir);
let fqdn = tofu.output(dir, "endpoint_fqdn");
let ok_destroy = tofu.destroy(dir);
end _dsl_

savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 60000);
assert(r.code == 0, "host execution failed: " + r.stderr);
assert(starts_with(r.stdout, "{\"ok\": true"), "expected ok json output");

println("ok 04-variables-and-locals - injected variables and evaluated local expressions");
